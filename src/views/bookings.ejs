<%- include('partials/header') %>

  <section class="content">
    <h1>Bookings</h1>

    <div id="bookings-container">
      <p id="bookings-loading">Loading bookings...</p>
      <p id="bookings-error" hidden></p>
    </div>
  </section>

  <template id="booking-card-template">
    <article>
      <h2 data-field="booking-id"></h2>
      <p data-field="trip"></p>
      <p data-field="schedule"></p>
      <p data-field="ticket-class"></p>
      <p data-field="selected-day"></p>

      <h3>Passengers</h3>
      <ul data-field="passengers"></ul>

      <p data-field="created"></p>
    </article>
  </template>

  <%- include('partials/footer') %>