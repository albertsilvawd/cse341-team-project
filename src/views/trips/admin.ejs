<%- include('../partials/header') %>

<main class="container">
  <h1>Trip Management (Admin)</h1>
  
  <p id="trip-feedback" role="status" aria-live="polite"></p>

  <!-- Search and Filter Toolbar -->
  <section class="admin-filter-toolbar" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; margin-bottom: 2rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
    <div class="form-group" style="margin-bottom: 0; flex: 1 1 200px;">
      <label for="search-input" style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Search Trips</label>
      <input type="text" id="search-input" placeholder="Search by name or description..." style="width: 100%; padding: 0.5rem;" />
    </div>

    <div class="form-group" style="margin-bottom: 0; flex: 1 1 150px;">
      <label for="region-filter" style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Region</label>
      <select id="region-filter" style="width: 100%; padding: 0.5rem;">
        <option value="">All Regions</option>
        <option value="kanto">Kanto</option>
        <option value="kansai">Kansai</option>
        <option value="hokkaido">Hokkaido</option>
        <option value="kyushu">Kyushu</option>
        <option value="chubu">Chubu</option>
        <option value="tohoku">Tohoku</option>
        <option value="shikoku">Shikoku</option>
        <option value="chugoku">Chugoku</option>
      </select>
    </div>

    <div class="form-group" style="margin-bottom: 0; flex: 1 1 150px;">
      <label for="season-filter" style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Season</label>
      <select id="season-filter" style="width: 100%; padding: 0.5rem;">
        <option value="">All Seasons</option>
        <option value="spring">Spring</option>
        <option value="summer">Summer</option>
        <option value="autumn">Autumn</option>
        <option value="winter">Winter</option>
        <option value="all year">All Year</option>
      </select>
    </div>

    <div class="filter-actions" style="display: flex; gap: 0.5rem;">
      <button type="button" id="apply-filters-btn" class="btn btn-primary">Filter</button>
      <button type="button" id="clear-filters-btn" class="btn btn-outline">Clear</button>
    </div>
  </section>

  <div id="trips-admin-list" class="trips-grid">
    <p>Loading trips...</p>
  </div>

  <!-- Pagination Controls -->
  <nav id="pagination-controls" class="pagination-container" aria-label="Trips pagination" style="display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 2rem;">
    <button type="button" id="prev-page-btn" class="btn btn-outline" disabled>&larr; Previous</button>
    <span id="page-indicator" aria-live="polite">Page 1</span>
    <button type="button" id="next-page-btn" class="btn btn-outline" disabled>Next &rarr;</button>
  </nav>

</main>

<!-- Normal Display Card Template -->
<template id="trip-card-template">
  <article class="trip-admin-card" data-trip-id="">
    <h3 class="trip-name"></h3>
    <p class="trip-route"></p>
    <p class="trip-distance"></p>
    <p class="trip-price"></p>
    <div class="card-actions">
      <button type="button" class="btn btn-secondary" data-action="edit">Edit</button>
      <button type="button" class="btn btn-danger" data-action="delete">Delete</button>
    </div>
  </article>
</template>

<!-- Dynamic In-Place Edit Form Template -->
<template id="trip-edit-template">
  <form class="trip-edit-form" data-trip-id="">
    <div class="form-group">
      <label>Trip Name
        <input type="text" name="name" required />
      </label>
    </div>
    <div class="form-group">
      <label>Start Station
        <select name="startStation" id="edit-start-station" required>
          <option value="">Select Start Station</option>
        </select>
      </label>
    </div>
    <div class="form-group">
      <label>End Station
        <select name="endStation" id="edit-end-station" required>
          <option value="">Select End Station</option>
        </select>
      </label>
    </div>
    <div class="form-group">
      <label>Schedule
        <select name="schedule" id="edit-schedule">
          <option value="">Select Schedule (Optional)</option>
        </select>
      </label>
    </div>
    <div class="form-group">
      <label>Distance (km)
        <input type="number" name="distance" min="0" step="1" required />
      </label>
    </div>
    <div class="form-group">
      <label>Base Price (¥)
        <input type="number" name="basePrice" min="0" step="1" />
      </label>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <button type="button" class="btn btn-outline" data-action="cancel">Cancel</button>
    </div>
  </form>
</template>

<script src="/js/trips-admin.js"></script>

<%- include('../partials/footer') %>
